@model IEnumerable<Store.Models.Article>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Articles";
}

<h2 class="mt-4">List of Articles</h2>
<hr />

<p>
    <a asp-controller="Articles" asp-action="Create" class="btn btn-primary">Create New Article</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExpirationDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @($"{item.Price:F2} zł")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExpirationDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.ImagePath) && item.ImagePath != "default.png")
                {
                    <img src="~/upload/@item.ImagePath" alt="@item.Name" style="max-height:50px;" />
                }
                else
                {
                    <img src="~/images/default.png" alt="No image" style="max-height:50px;" />
                }
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new
                {
                    id = item.Id
                }, new { @class = "btn btn-sm btn-info" }) |
                @Html.ActionLink("Details", "Details", new
                {
                    id = item.Id
                }, new { @class = "btn btn-sm btn-secondary" }) |
                @Html.ActionLink("Delete", "Delete", new
                {
                    id = item.Id
                }, new { @class = "btn btn-sm btn-danger" })
            </td>
        </tr>
}
    </tbody>
</table>