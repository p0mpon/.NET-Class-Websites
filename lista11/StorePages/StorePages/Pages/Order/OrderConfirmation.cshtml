@page
@model StorePages.Pages.Order.OrderConfirmationModel
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container mt-5">
    <div class="card border-success">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0">Thank you for your order!</h2>
        </div>
        <div class="card-body">
            <h4>Order Confirmation</h4>
            <hr />
            <p>Hello <strong>@Model.CustomerName</strong>,</p>
            <p>Your order has been successfully placed and is now being processed.</p>
            
            <div class="bg-light p-3 border rounded">
                <h5>Summary:</h5>
                <ul class="list-unstyled">
                    <li><strong>Customer:</strong> @Model.CustomerName</li>
                    <li><strong>Payment Method:</strong> @Model.PaymentMethod</li>
                    <li><strong>Status:</strong> <span class="badge bg-primary">Confirmed</span></li>
                </ul>
            </div>

            <div class="alert alert-info mt-3">
                <i class="bi bi-info-circle"></i> Your cart has been cleared. 
            </div>

            <div class="mt-4">
                <a asp-page="/Shop/Index" class="btn btn-outline-primary">Return to Shop</a>
            </div>
        </div>
    </div>
</div>