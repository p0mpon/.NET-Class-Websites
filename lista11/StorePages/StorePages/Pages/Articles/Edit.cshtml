@page
@model StorePages.Pages.Articles.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Article</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Article.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Article.Name" class="control-label"></label>
                <input asp-for="Article.Name" class="form-control" />
                <span asp-validation-for="Article.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Article.Price" class="control-label"></label>
                <input asp-for="Article.Price" class="form-control" />
                <span asp-validation-for="Article.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Current Image</label>
                @if (!string.IsNullOrWhiteSpace(Model.Article.ImagePath) && Model.Article.ImagePath != "images/default.png")
                {
                    <img id="preview" src="~/upload/@Model.Article.ImagePath" alt="Current image" style="max-width:200px; display:block;" />
                }
                else
                {
                    <img id="preview" src="~/images/default.png" alt="Placeholder" style="max-width:200px; display:block;" />
                }
            </div>
            <div class="form-group mt-3">
                @Html.LabelFor(model => model.Article.FormFile, new { @class = "control-label" })
                <input asp-for="Article.FormFile" class="form-control" type="file" accept="image/*" onchange="previewFile(event)" />
                @Html.ValidationMessageFor(model => model.Article.FormFile, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Article.ExpirationDate" class="control-label"></label>
                <input asp-for="Article.ExpirationDate" class="form-control" />
                <span asp-validation-for="Article.ExpirationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Article.CategoryId" class="control-label"></label>
                <select asp-for="Article.CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="Article.CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        var previewFile = function (event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('preview');
                output.src = reader.result;
                output.style.display = "block";
                output.style.maxWidth = "200px";
            };
            reader.readAsDataURL(event.target.files[0]);
        };
    </script>
}
