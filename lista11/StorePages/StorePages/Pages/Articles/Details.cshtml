@page
@model StorePages.Pages.Articles.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>Article</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Article.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Article.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Article.Price)
        </dt>
        <dd class="col-sm-10">
            @($"{Model.Article.Price:F2} zł")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Article.ExpirationDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Article.ExpirationDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Article.Category)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Article.Category!.Name)
        </dd>
        <dt class = "col-sm-2">Image</dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.Article.ImagePath) && Model.Article.ImagePath != "default.png")
            {
                <img src="~/upload/@Model.Article.ImagePath" alt="@Model.Article.Name" />
            }
            else
            {
                <img src="~/images/default.png" alt="No image" />
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Article.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
